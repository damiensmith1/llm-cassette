{
  "name": "llm-cassette",
  "version": "0.0.0",
  "private": true,
  "description": "Record/replay for LLM API calls in tests. Cassettes that survive prompt edits, judged by Jev.",
  "license": "MIT",
  "author": "Damien Smith",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/damiensmith1/llm-cassette"
  },
  "keywords": [
    "llm",
    "testing",
    "vcr",
    "cassette",
    "record",
    "replay",
    "openai",
    "anthropic",
    "vitest",
    "jev"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/adapters/vitest.d.ts",
        "default": "./dist/adapters/vitest.js"
      },
      "require": {
        "types": "./dist/adapters/vitest.d.cts",
        "default": "./dist/adapters/vitest.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@mswjs/interceptors": "^0.45.5",
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
